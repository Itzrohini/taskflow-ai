# Application runtime environment (development, staging, production)
APP_ENV=development

# Allowed CORS origins (comma-separated list, e.g. http://localhost:3000,http://localhost:3001)
CORS_ORIGINS=http://localhost:3000

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase anon public API key
SUPABASE_ANON_KEY=

# Optional legacy Supabase HS256 JWT secret
SUPABASE_JWT_SECRET=

# Google Gemini API key
GEMINI_API_KEY=

# Google Gemini model identifier
GEMINI_MODEL=gemini-2.5-flash

# Timeout in seconds for AI generation calls
AI_TIMEOUT_SECONDS=20

# Maximum AI generation requests per hour per user
AI_RATE_LIMIT_PER_HOUR=30
