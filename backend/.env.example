# Application runtime environment (development, staging, production)
APP_ENV=development

# Allowed CORS origins (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Local MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name
MONGODB_DB_NAME=taskflow_ai

# MongoDB server selection timeout in milliseconds
MONGODB_TIMEOUT_MS=5000

# Google Gemini API key
GEMINI_API_KEY=

# Google Gemini model identifier
GEMINI_MODEL=gemini-2.5-flash

# Timeout in seconds for AI generation calls
AI_TIMEOUT_SECONDS=20

# Maximum AI requests per hour per client IP (per process)
AI_RATE_LIMIT_PER_HOUR=100
